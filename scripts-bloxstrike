local function updateDrawESP(obj, myPos, now)
local model = obj.model
local hum, root = getAlive(model)
local visible = false
local col = obj.enemy and Config.Col_Enemy or Config.Col_Team
if root then
local dist = (root.Position - myPos).Magnitude
if dist <= Config.Esp_MaxDist then
local head = model:FindFirstChild("Head")
local topPos, botPos
if head then
topPos = head.Position + Vector3.new(0, 0.7, 0)
botPos = root.Position - Vector3.new(0, 3.0, 0)
if botPos.Y > topPos.Y then botPos = topPos - Vector3.new(0, 4.5, 0) end
else
-- GetBoundingBox раз в 0.3с, а не каждый кадр (меньше нагрузки)
if now - obj.bbAt > 0.3 or not obj.bbTop then
obj.bbAt = now
local okBB, bcf, bsz = pcall(function()
return model:GetBoundingBox()
end)
if okBB and bcf and bsz and bsz.Y > 0.5 then
local halfY = clamp(bsz.Y * 0.5, 1.6, 3.8)
obj.bbTop = bcf.Position + Vector3.new(0, halfY, 0)
obj.bbBot = bcf.Position - Vector3.new(0, halfY, 0)
else
obj.bbTop = root.Position + Vector3.new(0, 3.1, 0)
obj.bbBot = root.Position - Vector3.new(0, 3.6, 0)
end
end
topPos = obj.bbTop
botPos = obj.bbBot
end
local topS = Camera:WorldToViewportPoint(topPos)
local botS = Camera:WorldToViewportPoint(botPos)
local rootS = Camera:WorldToViewportPoint(root.Position)
if topS.Z > 0 or botS.Z > 0 or rootS.Z > 0 then
visible = true
local h = math.abs(botS.Y - topS.Y)
if h < 14 then h = 14 end
local w = h * 0.55
if w < 12 then w = 12 end
local cx = rootS.X
if rootS.Z <= 0 then cx = (topS.X + botS.X) / 2 end
local x = cx - w / 2
local y = math.min(topS.Y, botS.Y)
local mainC = C3(col)
-- проверка стены раз в 0.25с, а не каждый кадр
if now - obj.visAt > 0.25 then
obj.visAt = now
obj.visCache = isVisible(Camera.CFrame.Position, root, model)
end
if not obj.visCache then
mainC = Color3.fromRGB(col[1] * 0.45, col[2] * 0.45, col[3] * 0.45)
end
if Config.Esp_Box then
if Config.Esp_Style == "Уголки" then
obj.ensureCorners()
local cl = math.min(w, h) * 0.28
if cl < 5 then cl = 5 end
local c = obj.corners
if c[1] then c[1].From = Vector2.new(x, y); c[1].To = Vector2.new(x + cl, y); c[1].Color = mainC; c[1].Visible = true end
if c[2] then c[2].From = Vector2.new(x, y); c[2].To = Vector2.new(x, y + cl); c[2].Color = mainC; c[2].Visible = true end
if c[3] then c[3].From = Vector2.new(x + w, y); c[3].To = Vector2.new(x + w - cl, y); c[3].Color = mainC; c[3].Visible = true end
if c[4] then c[4].From = Vector2.new(x + w, y); c[4].To = Vector2.new(x + w, y + cl); c[4].Color = mainC; c[4].Visible = true end
if c[5] then c[5].From = Vector2.new(x, y + h); c[5].To = Vector2.new(x + cl, y + h); c[5].Color = mainC; c[5].Visible = true end
if c[6] then c[6].From = Vector2.new(x, y + h); c[6].To = Vector2.new(x, y + h - cl); c[6].Color = mainC; c[6].Visible = true end
if c[7] then c[7].From = Vector2.new(x + w, y + h); c[7].To = Vector2.new(x + w - cl, y + h); c[7].Color = mainC; c[7].Visible = true end
if c[8] then c[8].From = Vector2.new(x + w, y + h); c[8].To = Vector2.new(x + w, y + h - cl); c[8].Color = mainC; c[8].Visible = true end
if obj.box then obj.box.Visible = false end
if obj.boxOut then obj.boxOut.Visible = false end
else
if obj.box then
obj.box.Position = Vector2.new(x, y)
obj.box.Size = Vector2.new(w, h)
obj.box.Color = mainC
obj.box.Visible = true
end
if obj.boxOut then
obj.boxOut.Position = Vector2.new(x - 1, y - 1)
obj.boxOut.Size = Vector2.new(w + 2, h + 2)
obj.boxOut.Visible = true
end
for i = 1, 8 do
if obj.corners[i] then obj.corners[i].Visible = false end
end
end
else
if obj.box then obj.box.Visible = false end
if obj.boxOut then obj.boxOut.Visible = false end
for i = 1, 8 do
if obj.corners[i] then obj.corners[i].Visible = false end
end
end
local pct = 1
if hum then
pct = clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
end
if Config.Esp_HP and obj.hpBg then
obj.hpBg.Position = Vector2.new(x - 6, y)
obj.hpBg.Size = Vector2.new(3, h)
obj.hpBg.Visible = true
if obj.hpFill then
obj.hpFill.Position = Vector2.new(x - 5, y + h * (1 - pct))
