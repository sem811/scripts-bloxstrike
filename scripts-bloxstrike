-- на одних и тех же моделях. Кэш живёт 0.4 сек.
local function getAlive(model)
local now = os.clock()
local c = aliveCache[model]
if c and (now - c[3]) < 0.4 then return c[1], c[2] end
local hum, root = getAliveRaw(model)
if aliveCacheN > 300 then
aliveCache = {}
aliveCacheN = 0
end
aliveCache[model] = { hum, root, now }
aliveCacheN = aliveCacheN + 1
return hum, root
end
