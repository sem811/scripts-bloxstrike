dMenuClick = function(input)
if not dmenuOpen then return end
if input and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
local mp = UserInputService:GetMouseLocation()
for _, r in ipairs(dRows) do
if mp.Y >= r.y and mp.Y <= r.y + ROWH
and mp.X >= r.x and mp.X <= r.x + r.w then
if r.type == "toggle" then
Config[r.key] = not Config[r.key]
local rf = ToggleRefresh[r.key]
if rf then pcall(rf) end
if r.onChanged then pcall(r.onChanged, Config[r.key]) end
elseif r.type == "cycle" then
local list = r.options or r.presets
if list and #list > 0 then
local idx = 1
for i, v in ipairs(list) do
if Config[r.key] == v then idx = i break end
end
idx = idx + 1
if idx > #list then idx = 1 end
Config[r.key] = list[idx]
local rf = ToggleRefresh[r.key]
if rf then pcall(rf) end
if r.onChanged then pcall(r.onChanged, Config[r.key]) end
end
elseif r.type == "action" then
if r.action then pcall(r.action) end
end
dRefreshAll()
if updateStatus then pcall(updateStatus) end
break
end
end
end
